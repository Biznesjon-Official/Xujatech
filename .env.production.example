# Production Environment Variables Template
# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring

# MongoDB Configuration
MONGO_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# JWT Secrets (MUHIM: Kuchli va unique parollar ishlating!)
# Generatsiya qilish: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_VERY_STRONG_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_VERY_STRONG_REFRESH_SECRET_MIN_32_CHARS

# Telegram Bot Configuration (Optional)
TELEGRAM_SELLER_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CUSTOMER_BOT_TOKEN=

# Domain Configuration
DOMAIN=yourdomain.com
