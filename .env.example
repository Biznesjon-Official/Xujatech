# Root Environment Variables
# Bu fayl barcha muhitlar uchun umumiy sozlamalarni o'z ichiga oladi

# MongoDB Configuration (Production uchun)
MONGO_PASSWORD=your-secure-mongo-password-here

# JWT Secrets (Production uchun - kuchli parollar ishlating!)
JWT_SECRET=your-very-strong-jwt-secret-key-min-32-characters
JWT_REFRESH_SECRET=your-very-strong-refresh-secret-key-min-32-characters

# Telegram Bot Configuration
TELEGRAM_SELLER_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_CUSTOMER_BOT_TOKEN=your-customer-bot-token

# Domain Configuration
DOMAIN=yourdomain.com
