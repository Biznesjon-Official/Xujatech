# MongoDB
MONGO_PASSWORD=your-strong-mongodb-password-here

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long

# Application
NODE_ENV=production
PORT=3000

# Optional: External MongoDB (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/xujatech?retryWrites=true&w=majority