# Backend Production Environment Variables

# Server Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# MongoDB Configuration (Docker)
MONGODB_URI=mongodb://admin:YOUR_MONGO_PASSWORD@mongodb:27017/xujatech?authSource=admin

# Yoki MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/xujatech_pos?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=YOUR_VERY_STRONG_JWT_SECRET_MIN_32_CHARACTERS
JWT_REFRESH_SECRET=YOUR_VERY_STRONG_REFRESH_SECRET_MIN_32_CHARACTERS

# Telegram Bot Configuration
TELEGRAM_SELLER_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CUSTOMER_BOT_TOKEN=

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ENABLED=true
