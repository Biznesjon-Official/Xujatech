# Production Server Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://your-frontend-domain.com

# MongoDB Atlas - production database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/xujatech_pos_prod?retryWrites=true&w=majority

# JWT - kuchli secret key ishlatish kerak!
JWT_SECRET=your-very-strong-production-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-very-strong-production-refresh-secret-key-min-32-chars

# Telegram Bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
