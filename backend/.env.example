# Server Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# MongoDB Configuration
# Local MongoDB (Docker)
MONGODB_URI=mongodb://admin:your-mongo-password@mongodb:27017/xujatech?authSource=admin

# Yoki MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/xujatech_pos?retryWrites=true&w=majority

# JWT Configuration (MUHIM: Production uchun kuchli parollar ishlating!)
JWT_SECRET=change-this-to-a-very-strong-secret-key-min-32-characters
JWT_REFRESH_SECRET=change-this-to-a-very-strong-refresh-secret-min-32-characters

# Telegram Bot Configuration
TELEGRAM_SELLER_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_CUSTOMER_BOT_TOKEN=your-customer-bot-token-from-botfather

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ENABLED=true