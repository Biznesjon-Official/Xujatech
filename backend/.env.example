# Server Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://xujatech.biznesjon.uz

# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/xujatech_pos?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# Telegram Bot Configuration
TELEGRAM_SELLER_BOT_TOKEN=your-seller-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_CUSTOMER_BOT_TOKEN=your-customer-bot-token

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100